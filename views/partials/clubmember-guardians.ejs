<% const wards = guardians[member.MembershipNumber] || []; %>
<div class="mt-3 pt-2 border-t border-gray-200">
  <div class="flex items-center justify-between">
    <h5 class="text-xs font-semibold text-gray-600">Guardians (<%= wards.length %>)</h5>
    <button id="guardian-add-button-<%= member.MembershipNumber %>" class="text-xs text-blue-600 hover:underline cursor-pointer">
      + Add
    </button>
  </div>

  <% if (wards.length < 2) { %>
  <p class="mt-1 text-[11px] text-red-600">
    A minor member must have at least two guardians, one primary and one secondary.
  </p>
  <% } %>

  <ul class="mt-1 space-y-1">
    <% wards.forEach(function(g) { %>
    <li class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p class="text-xs">
          <%= g.FirstName %> <%= g.LastName %>
          <span class="text-gray-400">— <%= g.RelationshipType %></span>
        </p>
        <p class="text-[11px] text-gray-500 truncate"><%= g.PhoneNumber || '—' %></p>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <span class="px-1.5 py-0.5 text-[10px] font-semibold rounded <%= g.GuardianType === 'Primary' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
          <%= g.GuardianType %>
        </span>
        <% if (g.GuardianType !== 'Primary') { %>
        <form method="POST" action="/clubmembers/<%= member.MembershipNumber %>/guardians/<%= g.FamilyMemberID %>/primary">
          <button type="submit" title="Make this the primary guardian" class="px-1.5 py-0.5 text-[10px] rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer">
            Make primary
          </button>
        </form>
        <form method="POST" action="/clubmembers/<%= member.MembershipNumber %>/guardians/<%= g.FamilyMemberID %>/end"
              onsubmit="return confirm('End ' + <%= JSON.stringify(g.FirstName + ' ' + g.LastName) %> + ' as a guardian? The record is kept, but they stop being an active guardian.');">
          <button type="submit" class="px-1.5 py-0.5 text-[10px] rounded bg-red-600 text-white hover:bg-red-700 cursor-pointer">
            End
          </button>
        </form>
        <% } %>
      </div>
    </li>
    <% }); %>
  </ul>

  <div id="guardian-add-modal-<%= member.MembershipNumber %>" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto text-left">
      <div class="flex justify-between items-start mb-4">
        <h2 class="text-xl font-bold">Add Guardian</h2>
        <button type="button" class="text-gray-500 hover:text-gray-700" onclick="document.getElementById('guardian-add-modal-<%= member.MembershipNumber %>').classList.add('hidden')">
          🗙
        </button>
      </div>
      <p class="text-sm text-gray-500 mb-4">
        for <%= member.FirstName %> <%= member.LastName %>
      </p>

      <!-- Link an existing person: the common case for multi-child parents. -->
      <form class="space-y-3" method="POST" action="/clubmembers/<%= member.MembershipNumber %>/guardians">
        <input type="hidden" name="mode" value="existing">
        <h3 class="text-sm font-semibold text-gray-700">Link an existing family member</h3>
        <div>
          <label class="block text-sm font-medium text-gray-700">Family Member</label>
          <select name="familyMemberId" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <option value="" disabled selected>Select a person</option>
            <% familyMembers.forEach(function(fm) { %>
            <option value="<%= fm.FamilyMemberID %>"><%= fm.LastName %>, <%= fm.FirstName %></option>
            <% }); %>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Relationship</label>
            <select name="relationshipType" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <% ['Father','Mother','Grandfather','Grandmother','Tutor','Partner','Friend','Other'].forEach(function(r) { %>
              <option value="<%= r %>"><%= r %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Priority</label>
            <select name="guardianType" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <option value="Secondary" selected>Secondary</option>
              <option value="Primary">Primary</option>
            </select>
          </div>
        </div>
        <p class="text-xs text-gray-500">Choosing Primary makes the current primary guardian secondary.</p>
        <button type="submit" class="px-3 py-1 font-semibold text-sm rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer">
          Link Guardian
        </button>
      </form>

      <div class="my-5 border-t border-gray-200"></div>

      <!-- Or register someone not yet in the system. -->
      <form class="space-y-3" method="POST" action="/clubmembers/<%= member.MembershipNumber %>/guardians">
        <input type="hidden" name="mode" value="new">
        <h3 class="text-sm font-semibold text-gray-700">Or register a new person</h3>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">First Name</label>
            <input type="text" name="firstName" required maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Last Name</label>
            <input type="text" name="lastName" required maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Date of Birth</label>
            <input type="date" name="dateOfBirth" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">SSN</label>
            <input type="text" name="ssn" required maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Medicare Card Number</label>
            <input type="text" name="medicareCardNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Phone Number</label>
            <input type="text" name="phoneNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Email</label>
          <input type="email" name="email" maxlength="100" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Address</label>
          <input type="text" name="address" maxlength="200" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">City</label>
            <input type="text" name="city" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Province</label>
            <input type="text" name="province" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Postal Code</label>
            <input type="text" name="postalCode" maxlength="10" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Relationship</label>
            <select name="relationshipType" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <% ['Father','Mother','Grandfather','Grandmother','Tutor','Partner','Friend','Other'].forEach(function(r) { %>
              <option value="<%= r %>"><%= r %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Priority</label>
            <select name="guardianType" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <option value="Secondary" selected>Secondary</option>
              <option value="Primary">Primary</option>
            </select>
          </div>
        </div>
        <p class="text-xs text-gray-500">
          The new person is registered at this member's branch. Edit their other
          details later from the Family Members page.
        </p>
        <button type="submit" class="px-3 py-1 font-semibold text-sm rounded bg-green-600 text-white hover:bg-green-700 cursor-pointer">
          Create &amp; Link Guardian
        </button>
      </form>
    </div>
  </div>
</div>
