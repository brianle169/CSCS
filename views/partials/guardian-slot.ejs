<%
  // One guardian slot. `n` (1 or 2) namespaces fields as guardian1*/guardian2*,
  // folded into an array by routes/clubmembers.js.
  //
  // No `required` in markup: a hidden required field blocks submit.
  // eventListeners.js sets it on [data-req] fields only while visible.
%>
<div class="guardian-slot border border-gray-200 rounded-md p-3">
  <h4 class="text-sm font-semibold text-gray-700 mb-2">
    <%= title %>
    <span class="ml-1 px-1.5 py-0.5 text-[10px] font-semibold rounded <%= priority === 'Primary' ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600' %>">
      <%= priority %>
    </span>
  </h4>

  <div>
    <label class="block text-sm font-medium text-gray-700">Existing family member</label>
    <select id="guardian<%= n %>-existing" name="guardian<%= n %>FamilyMemberId"
            class="guardian-existing-select p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      <option value="">— Register a new person —</option>
      <% familyMembers.forEach(function(fm) { %>
      <option value="<%= fm.FamilyMemberID %>"><%= fm.LastName %>, <%= fm.FirstName %></option>
      <% }); %>
    </select>
  </div>

  <div id="guardian<%= n %>-new-fields" class="guardian-new-fields mt-3 space-y-3">
    <div class="grid grid-cols-2 gap-2">
      <div>
        <label class="block text-sm font-medium text-gray-700">First Name</label>
        <input type="text" data-req name="guardian<%= n %>FirstName" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Last Name</label>
        <input type="text" data-req name="guardian<%= n %>LastName" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <label class="block text-sm font-medium text-gray-700">Date of Birth</label>
        <input type="date" data-req name="guardian<%= n %>DateOfBirth" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">SSN</label>
        <input type="text" data-req name="guardian<%= n %>SSN" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <label class="block text-sm font-medium text-gray-700">Phone Number</label>
        <input type="text" name="guardian<%= n %>PhoneNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Email</label>
        <input type="email" name="guardian<%= n %>Email" maxlength="100" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Address</label>
      <input type="text" name="guardian<%= n %>Address" maxlength="200" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
    </div>
    <div class="grid grid-cols-3 gap-2">
      <div>
        <label class="block text-sm font-medium text-gray-700">City</label>
        <input type="text" name="guardian<%= n %>City" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Province</label>
        <input type="text" name="guardian<%= n %>Province" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700">Postal Code</label>
        <input type="text" name="guardian<%= n %>PostalCode" maxlength="10" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700">Medicare Card Number</label>
      <input type="text" name="guardian<%= n %>MedicareCardNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
    </div>
  </div>

  <div class="mt-3">
    <label class="block text-sm font-medium text-gray-700">Relationship to member</label>
    <select data-req name="guardian<%= n %>RelationshipType" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
      <% ['Mother','Father','Grandmother','Grandfather','Tutor','Partner','Friend','Other'].forEach(function(r) { %>
      <option value="<%= r %>"><%= r %></option>
      <% }); %>
    </select>
  </div>
</div>
