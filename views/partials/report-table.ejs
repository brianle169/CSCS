<% if (!rows || rows.length === 0) { %>
<p class="text-sm text-gray-400 italic py-4">No data yet — this report's query hasn't been implemented.</p>
<% } else { %>
<div class="overflow-x-auto">
  <table class="w-full text-sm border-collapse">
    <thead>
      <tr class="bg-gray-50 text-left text-gray-600">
        <% columns.forEach(function(col) { %>
        <th class="px-3 py-2 font-medium border-b whitespace-nowrap"><%= col %></th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(row) { %>
      <tr class="hover:bg-gray-50">
        <% row.forEach(function(cell) { %>
        <td class="px-3 py-2 border-b whitespace-nowrap"><%= cell %></td>
        <% }); %>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>
