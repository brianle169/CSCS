<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <link rel="stylesheet" href="/output.css" />
  <title>Locations</title>
</head>

<body>
  <h1 class="text-2xl font-bold">Locations</h1>

  <table class="border-collapse">
    <thead>
      <tr>
        <th class="border px-2">ID</th>
        <th class="border px-2">Type</th>
        <th class="border px-2">Name</th>
        <th class="border px-2">Address</th>
        <th class="border px-2">City</th>
        <th class="border px-2">Province</th>
        <th class="border px-2">Postal Code</th>
        <th class="border px-2">Web Address</th>
        <th class="border px-2">Max Capacity</th>
      </tr>
    </thead>
    <tbody>
      <% locations.forEach(function(loc) { %>
      <tr>
        <td class="border px-2"><%= loc.LocationID %></td>
        <td class="border px-2"><%= loc.Type %></td>
        <td class="border px-2"><%= loc.Name %></td>
        <td class="border px-2"><%= loc.Address %></td>
        <td class="border px-2"><%= loc.City %></td>
        <td class="border px-2"><%= loc.Province %></td>
        <td class="border px-2"><%= loc.PostalCode %></td>
        <td class="border px-2"><%= loc.WebAddress %></td>
        <td class="border px-2"><%= loc.MaxCapacity %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</body>

</html>