<script src="/js/eventListeners.js" defer></script>
<%- include('../partials/header', { title: "Club Members" }) %>
<main class="p-8 max-w-6xl w-full mx-auto grow">
  <h1 class="text-2xl font-bold mb-6">Club Members</h1>

  <% Object.values(clubMembers).forEach(function(location) { %>
  <section class="mb-10">
    <h2 class="text-xl font-bold mb-4"><%= location.LocationName %></h2>

    <% Object.values(location.Teams).forEach(function(team) { %>
    <div class="mb-6 pl-4 border-l-4 border-blue-200">
      <h3 class="text-lg font-semibold mb-3">
        <%= team.TeamName %>
        <span class="text-sm text-gray-500 font-normal">(<%= team.TeamGender %>)</span>
      </h3>

      <% if (team.Major.length === 0 && team.Minor.length === 0) { %>
      <p class="text-sm text-gray-400 italic">No members currently on this team.</p>
      <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h4 class="text-sm font-semibold text-gray-600 mb-2">Major Members</h4>
          <% if (team.Major.length === 0) { %>
          <p class="text-sm text-gray-400">None</p>
          <% } %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% team.Major.forEach(function(member) { %>
            <%- include('../partials/clubmember-card', { member: member, teams: teams, guardians: guardians, familyMembers: familyMembers }) %>
            <% }); %>
          </div>
        </div>

        <div>
          <h4 class="text-sm font-semibold text-gray-600 mb-2">Minor Members</h4>
          <% if (team.Minor.length === 0) { %>
          <p class="text-sm text-gray-400">None</p>
          <% } %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <% team.Minor.forEach(function(member) { %>
            <%- include('../partials/clubmember-card', { member: member, teams: teams, guardians: guardians, familyMembers: familyMembers }) %>
            <% }); %>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <% }); %>
  </section>
  <% }); %>

  <div class="bg-white rounded-lg shadow p-4 flex items-center justify-center max-w-xs">
    <button id="clubmember-add-button" class="text-lg font-semibold text-blue-600 hover:underline cursor-pointer">
      + Add New Club Member
    </button>
  </div>
  <div id="clubmember-add-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-start mb-4">
        <h2 class="text-xl font-bold mb-4">Add New Club Member</h2>
        <button type="button" class="text-gray-500 hover:text-gray-700" onclick="document.getElementById('clubmember-add-modal').classList.add('hidden')">
          🗙
        </button>
      </div>
      <form id="clubmember-add-form" class="space-y-3" method="POST" action="/clubmembers">
        <div>
          <label class="block text-sm font-medium text-gray-700">First Name</label>
          <input type="text" name="firstName" required maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Last Name</label>
          <input type="text" name="lastName" required maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Date of Birth</label>
          <input type="date" name="dateOfBirth" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Gender</label>
          <select name="gender" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <option value="" disabled selected>Select a gender</option>
            <option value="Boys">Boys</option>
            <option value="Girls">Girls</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Height (cm)</label>
          <input type="number" step="0.01" name="height" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Weight (kg)</label>
          <input type="number" step="0.01" name="weight" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">SSN</label>
          <input type="text" name="ssn" required maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Medicare Card Number</label>
          <input type="text" name="medicareCardNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Phone Number</label>
          <input type="text" name="phoneNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Email</label>
          <input type="email" name="email" maxlength="100" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Address</label>
          <input type="text" name="address" maxlength="200" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">City</label>
          <input type="text" name="city" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Province</label>
          <input type="text" name="province" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Postal Code</label>
          <input type="text" name="postalCode" maxlength="10" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Team</label>
          <select name="teamId" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
            <option value="" disabled selected>Select a team</option>
            <% teams.forEach(function(t) { %>
            <option value="<%= t.TeamID %>"><%= t.Name %></option>
            <% }); %>
          </select>
        </div>
        <p class="text-xs text-gray-500">Major/Minor status is set automatically based on date of birth.</p>

        <!-- Shown by eventListeners.js only when the date of birth makes this a
             minor. The server re-checks: a minor cannot be registered without
             two guardians, and guardians submitted for a major are ignored. -->
        <div id="clubmember-guardian-section" class="hidden space-y-3 pt-2 border-t border-gray-200">
          <div>
            <h3 class="text-sm font-semibold text-gray-700">Guardians</h3>
            <p class="text-xs text-gray-500">
              A minor member must be registered with two guardians. Pick someone
              already on file, or fill in the details to register a new person.
            </p>
          </div>
          <%- include('../partials/guardian-slot', { n: 1, title: 'Guardian 1', priority: 'Primary', familyMembers: familyMembers }) %>
          <%- include('../partials/guardian-slot', { n: 2, title: 'Guardian 2', priority: 'Secondary', familyMembers: familyMembers }) %>
        </div>

        <button type="submit" class="px-3 py-1 font-semibold text-sm rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer">
          Add Club Member
        </button>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
