  <script src="/js/eventListeners.js" defer></script>
  <%- include('../partials/header', { title: "CSCS Personnels" }) %>
  <main class="p-8 max-w-6xl mx-auto grow">
    <h1 class="text-2xl font-bold mb-6">Personnels</h1>

    <% Object.values(personnels).forEach(function(group) { %>
    <section class="mb-10">
      <h2 class="text-xl font-bold"><%= group.LocationName %></h2>
      <p class="text-sm text-gray-500 mb-4"><%= group.LocationType %></p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% group.Personnels.forEach(function(personnel) { %>
        <div class="bg-white rounded-lg shadow p-4">
          <a href="/personnels/<%= personnel.PersonnelID %>" class="text-lg font-semibold text-blue-600 hover:underline">
            <%= personnel.FirstName %> <%= personnel.LastName %>
          </a>
          <p class="text-sm text-gray-500 mb-2"><%= personnel.Role %></p>

          <dl class="text-sm text-gray-700 space-y-1">
            <div>Email: <%= personnel.Email %></div>
            <div>Phone: <%= personnel.PhoneNumber %></div>
            <div>City: <%= personnel.City %>, <%= personnel.Province %></div>
            <div>Mandate: <%= personnel.Mandate %></div>
          </dl>

          <div class="mt-4 flex gap-2">
            <button id="personnel-edit-button-<%= personnel.PersonnelID %>" class="px-3 py-1 text-sm rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer">
              Edit
            </button>
            <div id="personnel-edit-modal-<%= personnel.PersonnelID %>" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
              <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto">
                <div class="flex justify-between items-start mb-4">
                  <h2 class="text-xl font-bold mb-4">Edit Personnel</h2>
                  <button type="button" class="text-gray-500 hover:text-gray-700" onclick="document.getElementById('personnel-edit-modal-<%= personnel.PersonnelID %>').classList.add('hidden')">
                    🗙
                  </button>
                </div>
                <form id="personnel-edit-form-<%= personnel.PersonnelID %>" class="space-y-3" method="POST" action="/personnels/<%= personnel.PersonnelID %>/edit">
                  <div>
                    <label for="ssn" class="block text-sm font-medium text-gray-700">SSN</label>
                    <input type="text" name="ssn" id="ssn" required maxlength="20" value="<%= personnel.SSN %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="firstName" class="block text-sm font-medium text-gray-700">First Name</label>
                    <input type="text" name="firstName" id="firstName" required maxlength="50" value="<%= personnel.FirstName %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="lastName" class="block text-sm font-medium text-gray-700">Last Name</label>
                    <input type="text" name="lastName" id="lastName" required maxlength="50" value="<%= personnel.LastName %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="dateOfBirth" class="block text-sm font-medium text-gray-700">Date of Birth</label>
                    <input type="date" name="dateOfBirth" id="dateOfBirth" required value="<%= personnel.DateOfBirth instanceof Date ? personnel.DateOfBirth.toISOString().split('T')[0] : personnel.DateOfBirth %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="medicareCardNumber" class="block text-sm font-medium text-gray-700">Medicare Card Number</label>
                    <input type="text" name="medicareCardNumber" id="medicareCardNumber" maxlength="20" value="<%= personnel.MedicareCardNumber %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="phoneNumber" class="block text-sm font-medium text-gray-700">Phone Number</label>
                    <input type="text" name="phoneNumber" id="phoneNumber" maxlength="20" value="<%= personnel.PhoneNumber %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="address" class="block text-sm font-medium text-gray-700">Address</label>
                    <input type="text" name="address" id="address" maxlength="200" value="<%= personnel.Address %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="city" class="block text-sm font-medium text-gray-700">City</label>
                    <input type="text" name="city" id="city" maxlength="50" value="<%= personnel.City %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="province" class="block text-sm font-medium text-gray-700">Province</label>
                    <input type="text" name="province" id="province" maxlength="50" value="<%= personnel.Province %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="postalCode" class="block text-sm font-medium text-gray-700">Postal Code</label>
                    <input type="text" name="postalCode" id="postalCode" maxlength="10" value="<%= personnel.PostalCode %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" name="email" id="email" maxlength="100" value="<%= personnel.Email %>" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                  </div>
                  <div>
                    <label for="role" class="block text-sm font-medium text-gray-700">Role</label>
                    <select name="role" id="role" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                      <option value="Administrator" <%= personnel.Role === 'Administrator' ? 'selected' : '' %>>Administrator</option>
                      <option value="Captain" <%= personnel.Role === 'Captain' ? 'selected' : '' %>>Captain</option>
                      <option value="Coach" <%= personnel.Role === 'Coach' ? 'selected' : '' %>>Coach</option>
                      <option value="Assistant Coach" <%= personnel.Role === 'Assistant Coach' ? 'selected' : '' %>>Assistant Coach</option>
                      <option value="Other" <%= personnel.Role === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                  </div>
                  <div>
                    <label for="mandate" class="block text-sm font-medium text-gray-700">Mandate</label>
                    <select name="mandate" id="mandate" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                      <option value="Volunteer" <%= personnel.Mandate === 'Volunteer' ? 'selected' : '' %>>Volunteer</option>
                      <option value="Salaried" <%= personnel.Mandate === 'Salaried' ? 'selected' : '' %>>Salaried</option>
                    </select>
                  </div>
                  <button type="submit" class="px-3 py-1 font-semibold text-sm rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer">
                    Edit Personnel
                  </button>
                </form>
                <form method="POST" action="/personnels/<%= personnel.PersonnelID %>/delete" class="mt-3 text-center" onsubmit="return confirm('This permanently deletes ' + <%= JSON.stringify(personnel.FirstName + ' ' + personnel.LastName) %> + ' and their full work history. This cannot be undone. Continue?');">
                  <button type="submit" class="text-xs text-red-600 hover:underline cursor-pointer">
                    Delete permanently
                  </button>
                </form>
              </div>
            </div>
            <form method="POST" action="/personnels/<%= personnel.PersonnelID %>/end-contract" onsubmit="return confirm('End this personnel\'s current contract? They will no longer show as active at this location.');">
              <button type="submit" class="px-3 py-1 text-sm rounded bg-amber-600 text-white hover:bg-amber-700 cursor-pointer">
                End Contract
              </button>
            </form>
          </div>
        </div>
        <% }); %>
      </div>
    </section>
    <% }); %>

    <div class="bg-white rounded-lg shadow p-4 flex items-center justify-center max-w-xs">
      <button id="personnel-add-button" class="text-lg font-semibold text-blue-600 hover:underline cursor-pointer">
        + Add New Personnel
      </button>
    </div>
    <div id="personnel-add-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
      <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-start mb-4">
          <h2 class="text-xl font-bold mb-4">Add New Personnel</h2>
          <button type="button" class="text-gray-500 hover:text-gray-700" onclick="document.getElementById('personnel-add-modal').classList.add('hidden')">
            🗙
          </button>
        </div>
        <form id="personnel-add-form" class="space-y-3" method="POST" action="/personnels">
          <div>
            <label for="add-ssn" class="block text-sm font-medium text-gray-700">SSN</label>
            <input type="text" name="ssn" id="add-ssn" required maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-firstName" class="block text-sm font-medium text-gray-700">First Name</label>
            <input type="text" name="firstName" id="add-firstName" required maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-lastName" class="block text-sm font-medium text-gray-700">Last Name</label>
            <input type="text" name="lastName" id="add-lastName" required maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-dateOfBirth" class="block text-sm font-medium text-gray-700">Date of Birth</label>
            <input type="date" name="dateOfBirth" id="add-dateOfBirth" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-medicareCardNumber" class="block text-sm font-medium text-gray-700">Medicare Card Number</label>
            <input type="text" name="medicareCardNumber" id="add-medicareCardNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-phoneNumber" class="block text-sm font-medium text-gray-700">Phone Number</label>
            <input type="text" name="phoneNumber" id="add-phoneNumber" maxlength="20" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-address" class="block text-sm font-medium text-gray-700">Address</label>
            <input type="text" name="address" id="add-address" maxlength="200" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-city" class="block text-sm font-medium text-gray-700">City</label>
            <input type="text" name="city" id="add-city" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-province" class="block text-sm font-medium text-gray-700">Province</label>
            <input type="text" name="province" id="add-province" maxlength="50" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-postalCode" class="block text-sm font-medium text-gray-700">Postal Code</label>
            <input type="text" name="postalCode" id="add-postalCode" maxlength="10" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-email" class="block text-sm font-medium text-gray-700">Email</label>
            <input type="email" name="email" id="add-email" maxlength="100" class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <div>
            <label for="add-role" class="block text-sm font-medium text-gray-700">Role</label>
            <select name="role" id="add-role" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <option value="" disabled selected>Select a role</option>
              <option value="Administrator">Administrator</option>
              <option value="Captain">Captain</option>
              <option value="Coach">Coach</option>
              <option value="Assistant Coach">Assistant Coach</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="add-mandate" class="block text-sm font-medium text-gray-700">Mandate</label>
            <select name="mandate" id="add-mandate" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <option value="" disabled selected>Select a mandate</option>
              <option value="Volunteer">Volunteer</option>
              <option value="Salaried">Salaried</option>
            </select>
          </div>
          <hr class="my-2">
          <div>
            <label for="add-locationId" class="block text-sm font-medium text-gray-700">Location</label>
            <select name="locationId" id="add-locationId" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
              <option value="" disabled selected>Select a location</option>
              <% locations.forEach(function(loc) { %>
              <option value="<%= loc.LocationID %>"><%= loc.Name %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label for="add-startDate" class="block text-sm font-medium text-gray-700">Start Date</label>
            <input type="date" name="startDate" id="add-startDate" required class="p-2 mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <button type="submit" class="px-3 py-1 font-semibold text-sm rounded bg-blue-600 text-white hover:bg-blue-700 cursor-pointer">
            Add Personnel
          </button>
        </form>
      </div>
    </div>
    </div>
  </main>
  <%- include('../partials/footer') %>